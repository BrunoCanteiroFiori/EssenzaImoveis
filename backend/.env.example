PORT=4000
# Interface em que a API escuta (0.0.0.0 dentro de container)
HOST=localhost
# Redes dos proxies reversos confiáveis para X-Forwarded-For/Proto (CIDR, separadas por vírgula). Vazio: só localhost.
ForwardedHeaders__KnownNetworks=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=corretora
POSTGRES_PORT=5432
ConnectionStrings__Default="Host=localhost;Port=5432;Database=corretora;Username=postgres;Password=postgres"

# Origens do frontend autorizadas a chamar a API com cookies (separadas por vírgula)
Cors__AllowedOrigins=http://localhost:3000

# JWT: gere um segredo aleatório com pelo menos 32 bytes (ex.: openssl rand -base64 48)
Jwt__Issuer=corretora-api
Jwt__Audience=corretora-web
Jwt__Secret=TROQUE-POR-UM-SEGREDO-ALEATORIO-COM-PELO-MENOS-32-BYTES
Jwt__AccessTokenMinutes=15

# Cookies com flag Secure (true em produção, com HTTPS)
Auth__SecureCookies=false

# Conta fixa de super admin, criada ao subir a API se ainda não existir.
# Senha: 10 a 128 caracteres, com letras e números.
SuperAdmin__Name=Super Admin
SuperAdmin__Email=admin@corretora.com.br
SuperAdmin__Password=TROQUE-esta-senha-123

# Onde ficam as fotos e vídeos dos imóveis: GoogleDrive (padrão) ou Local (disco, só para desenvolvimento sem conta Google)
Storage__Provider=GoogleDrive
# Pasta usada com Storage__Provider=Local (relativa a src/Backend.Api)
Storage__RootPath=uploads

# Google Drive de uma conta pessoal (OAuth). Passo a passo para gerar em deploy/README.md, seção "Google Drive".
GoogleDrive__ClientId=
GoogleDrive__ClientSecret=
GoogleDrive__RefreshToken=
# Pasta pública criada pelo backend na raiz do Meu Drive, com uma subpasta por imóvel (dentro de "properties")
GoogleDrive__RootFolderName=SiteCorretora
