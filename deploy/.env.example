# Configuração de produção. Copie para DEPLOY_PATH/.env no servidor e preencha.
# Este arquivo vai para o git; o .env de verdade fica só no servidor.

# --- Endereços públicos (Caddy) ---
# Só IP, sem certificado (HTTP): site na porta 80 e API na 8080.
SITE_ADDRESS=:80
API_ADDRESS=:8080
# Com domínio (HTTPS automático pelo Let's Encrypt):
# SITE_ADDRESS=seudominio.com.br, www.seudominio.com.br
# API_ADDRESS=api.seudominio.com.br

# --- Banco ---
# Senha só com letras e números (ex.: openssl rand -hex 24): ela entra na connection string.
POSTGRES_USER=corretora
POSTGRES_PASSWORD=
POSTGRES_DB=corretora

# --- API ---
# Origem do site autorizada a chamar a API: mesmo valor da variável NEXT_PUBLIC_SITE_URL do GitHub.
# Só IP: http://SEU_IP    Com domínio: https://seudominio.com.br
Cors__AllowedOrigins=http://SEU_IP

# Segredo do JWT com pelo menos 32 bytes (ex.: openssl rand -base64 48)
Jwt__Issuer=corretora-api
Jwt__Audience=corretora-web
Jwt__Secret=
Jwt__AccessTokenMinutes=15

# false enquanto o site estiver só em HTTP (IP). true assim que tiver domínio com HTTPS.
Auth__SecureCookies=false

# Conta fixa de super admin, criada ao subir a API se ainda não existir.
# Senha: 10 a 128 caracteres, com letras e números.
SuperAdmin__Name=Super Admin
SuperAdmin__Email=
SuperAdmin__Password=

# --- Fotos e vídeos (Google Drive de conta pessoal, OAuth) ---
# Como gerar: README.md, seção "Google Drive". O backend cria a pasta pública abaixo na raiz do Meu Drive.
Storage__Provider=GoogleDrive
GoogleDrive__ClientId=
GoogleDrive__ClientSecret=
GoogleDrive__RefreshToken=
GoogleDrive__RootFolderName=SiteCorretora
