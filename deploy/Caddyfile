# Proxy reverso público. Os endereços vêm do .env do servidor:
#   só IP:      SITE_ADDRESS=:80                    API_ADDRESS=:8080            (HTTP)
#   com domínio: SITE_ADDRESS=seudominio.com.br     API_ADDRESS=api.seudominio.com.br  (HTTPS automático)

{$SITE_ADDRESS} {
	encode zstd gzip
	reverse_proxy web:3000
}

{$API_ADDRESS} {
	encode zstd gzip
	reverse_proxy api:4000
}
